{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScholarFlowRunExecutionConfig",
  "description": "Canonical schema for a confirmed run-level execution configuration (RFC-014 / P2-02, R04). Execution tiers (quick/standard/deep) are immutable presets; this document is the authorised configuration for one run and is what gets saved to runs/<run_id>/execution_profile.json.",
  "type": "object",
  "required": [
    "schema_version",
    "profile_version",
    "run_id",
    "depth",
    "selection_source",
    "selection",
    "stages",
    "budgets",
    "capabilities",
    "enforcement"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "profile_version": { "type": "string", "const": "depth-v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "depth": {
      "type": "string",
      "enum": ["quick", "standard", "deep"]
    },
    "execution_depth": {
      "type": "string",
      "enum": ["quick", "standard", "deep"],
      "description": "Alias of `depth`, emitted for downstream convenience; both must agree."
    },
    "name_zh": { "type": "string" },
    "selection_source": {
      "type": "string",
      "enum": [
        "EXPLICIT_ARG",
        "INTERACTIVE_CONFIRMED",
        "RUN_PROFILE_INHERITED",
        "CONTEXT_RESOLVED"
      ]
    },
    "selection": {
      "type": "object",
      "description": "Auditable record of how the depth for this run was chosen (R04/R07).",
      "required": ["status", "source", "scope"],
      "properties": {
        "status": { "type": "string", "enum": ["confirmed", "pending", "rejected"] },
        "source": {
          "type": "string",
          "enum": [
            "EXPLICIT_ARG",
            "INTERACTIVE_CONFIRMED",
            "RUN_PROFILE_INHERITED",
            "CONTEXT_RESOLVED"
          ]
        },
        "scope": { "type": "string", "enum": ["stage", "pipeline"] },
        "selected_value": {
          "type": ["string", "null"],
          "enum": ["quick", "standard", "deep", null]
        },
        "confirmed_by": { "type": "string" },
        "confirmed_at": { "type": ["string", "null"] },
        "intent": { "type": "string" },
        "reason": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "interaction_mode": { "type": "string", "enum": ["interactive", "headless"] },
    "stages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["discovery", "extraction", "synthesis", "full_pipeline"]
      }
    },
    "budgets": {
      "type": "object",
      "description": "Effective resource ceiling for this run.",
      "required": [
        "max_search_candidates",
        "snowball_rounds",
        "extraction_unit_limit",
        "max_active_seconds",
        "max_model_requests"
      ],
      "properties": {
        "max_search_candidates": { "type": "integer", "minimum": 1 },
        "snowball_rounds": { "type": "integer", "minimum": 0 },
        "concept_expansion_rounds": { "type": "integer", "minimum": 0 },
        "extraction_unit_limit": { "type": "integer", "minimum": 1 },
        "max_active_seconds": { "type": "integer", "minimum": 1 },
        "max_model_requests": { "type": "integer", "minimum": 1 },
        "max_token_ceiling": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "description": "Methodological capability switches granted to this run.",
      "properties": {
        "ocr_scan_policy": { "type": "string" },
        "figure_table_verification": { "type": "string" },
        "cross_validation_budget": { "type": "integer", "minimum": 0 },
        "spot_check_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "devils_advocate_mode": { "type": "string" }
      },
      "additionalProperties": false
    },
    "enforcement": {
      "type": "string",
      "enum": ["best_effort", "hard"],
      "default": "best_effort"
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "parent_run_id": { "type": ["string", "null"] },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
