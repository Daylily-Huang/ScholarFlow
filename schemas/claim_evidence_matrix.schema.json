{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScholarFlowClaimEvidenceMatrix",
  "description": "Canonical envelope schema for claim-evidence matrices linking ClaimRecords and EvidenceRecords.",
  "type": "object",
  "required": [
    "schema_version",
    "matrix_id",
    "topic",
    "claims"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "matrix_id": { "type": "string" },
    "topic": { "type": "string" },
    "generated_at": { "type": "string" },
    "metadata": {
      "type": "object",
      "properties": {
        "domain_profile": { "type": "string" },
        "mode": { "type": "string" }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "./claim_record.schema.json"
      }
    },
    "evidence_records": {
      "type": "array",
      "items": {
        "$ref": "./evidence_record.schema.json"
      }
    }
  }
}
