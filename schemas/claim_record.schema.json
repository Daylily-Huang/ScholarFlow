{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScholarFlowClaimRecord",
  "description": "Standard schema for synthesis claims with multi-dimensional appraisal.",
  "type": "object",
  "required": [
    "schema_version",
    "claim_id",
    "topic",
    "paper_id",
    "claim",
    "stance"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "claim_id": { "type": "string" },
    "topic": { "type": "string" },
    "paper_id": { "type": "string" },
    "year": { "type": ["integer", "string", "null"] },
    "claim": { "type": "string" },
    "stance": {
      "type": "string",
      "enum": ["SUPPORT", "REFUTE", "CONDITIONAL", "NEUTRAL"]
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Cross-references to evidence_record.evidence_id"
    },
    "method": { "type": ["string", "null"] },
    "metric_value": { "type": ["number", "null"] },
    "confidence_interval": {
      "type": ["array", "null"],
      "items": { "type": "number" }
    },
    "evidence_strength": {
      "type": "string",
      "enum": [
        "DIRECT_EMPIRICAL",
        "MODELED_EMPIRICAL",
        "AUTHOR_INTERPRETATION",
        "SECONDARY_EVIDENCE",
        "EXPERT_OPINION",
        "UNKNOWN"
      ]
    },
    "evidence_tier": {
      "type": "string",
      "description": "Backward-compatible alias for E1-E4."
    },
    "appraisal": {
      "type": "object",
      "properties": {
        "directness": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"] },
        "independence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"] },
        "risk_of_bias": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"] },
        "replication": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"] }
      }
    },
    "boundary": { "type": ["string", "object", "null"] }
  }
}
