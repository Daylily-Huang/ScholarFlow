# ============================================================
# Stage 8B 浏览器兜底下载凭据文件示例
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env（去掉 _example 后缀）
#   2. 填入真实凭据
#   3. 确保 .env 已加入 .gitignore
#
# 安全提醒：
#   - Agent 只在 Stage 8B 执行时读取本文件
#   - Agent 绝不将凭据写入日志、台账或任何输出文件
#   - Agent 绝不在对话中回显密码明文
#   - 若本文件不存在或变量缺失，对应站点自动跳过
# ============================================================

# --- 中国知网 CNKI ---
CNKI_USERNAME=your_cnki_username
CNKI_PASSWORD=your_cnki_password

# --- 万方数据 ---
WANFANG_USERNAME=your_wanfang_username
WANFANG_PASSWORD=your_wanfang_password

# --- 学校图书馆 VPN/代理 ---
UNI_USERNAME=your_university_student_id
UNI_PASSWORD=your_university_password

# --- 学校代理 URL（需替换为你的学校实际地址） ---
# UNIVERSITY_PROXY_URL=https://vpn.youruni.edu.cn/
# UNIVERSITY_PROXY_PREFIX=https://vpn.youruni.edu.cn/proxy/
