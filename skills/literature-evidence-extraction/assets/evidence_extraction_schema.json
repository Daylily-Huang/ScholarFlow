{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceExtractionRecord",
  "description": "JSON Schema for literature-evidence-extraction Skill extracted facts and evidence ledger.",
  "type": "object",
  "required": [
    "schema_version",
    "paper_metadata",
    "extraction_metadata",
    "evidence_records",
    "auditor_verdict"
  ],
  "properties": {
    "schema_version": { "type": "string", "default": "1.0" },
    "paper_metadata": {
      "type": "object",
      "required": ["title", "authors", "year"],
      "properties": {
        "title": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "year": { "type": ["integer", "string"] },
        "journal": { "type": "string" },
        "doi": { "type": "string" },
        "file_path": { "type": "string" }
      }
    },
    "extraction_metadata": {
      "type": "object",
      "required": ["mode", "timestamp", "schema_type"],
      "properties": {
        "mode": { "type": "string", "enum": ["extract", "audit", "batch_matrix"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "schema_type": { "type": "string", "enum": ["dynamic", "custom", "methods_only", "results_only"] }
      }
    },
    "relevance_assessment": {
      "type": "object",
      "required": ["score", "decision", "rationale"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 10, "description": "Relevance score from 0 to 10 (PaperQA2 benchmark)" },
        "decision": { "type": "string", "enum": ["PROCEED", "PRUNE"], "description": "PROCEED if score >= 6; PRUNE if score < 6" },
        "rationale": { "type": "string", "description": "Reason for relevance score and pruning decision" }
      }
    },
    "reviewer_quadrant_audit": {
      "type": "object",
      "properties": {
        "q1_scientific_question": { "type": "string", "description": "Target scientific question and motivation" },
        "q2_prior_limitations": { "type": "string", "description": "Prior literature bottlenecks and method limitations addressed" },
        "q3_proposed_novelty": { "type": "string", "description": "Novel method, design, or framework introduced" },
        "q4_rigor_and_caveats": { "type": "string", "description": "Experimental rigor, controls, caveats, and confounding factors" }
      }
    },
    "assays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assay_id", "assay_name"],
        "properties": {
          "assay_id": { "type": "string" },
          "assay_name": { "type": "string" },
          "target_locus_or_gene": { "type": "string" },
          "section": { "type": "string" }
        }
      }
    },
    "evidence_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "extracted_value",
          "support_type",
          "verbatim_quote"
        ],
        "properties": {
          "evidence_id": { "type": "string" },
          "record_id": { "type": "string" },
          "field": { "type": "string" },
          "field_id": { "type": "string" },
          "field_name": { "type": "string" },
          "context_unit": {
            "type": ["object", "null"],
            "properties": {
              "context_id": { "type": "string" },
              "context_type": { "type": "string" }
            }
          },
          "module": {
            "type": "string",
            "enum": ["metadata", "methods", "parameters", "results", "analysis"]
          },
          "assay_id": { "type": ["string", "null"] },
          "extracted_value": { "type": ["string", "number", "null"] },
          "support_type": {
            "type": "string",
            "enum": ["EXPLICIT", "DERIVED", "REFERENCED", "NOT_REPORTED"],
            "description": "How the field value is anchored in this paper text."
          },
          "evidence_strength": {
            "type": ["string", "null"],
            "enum": ["DIRECT_EMPIRICAL", "MODELED_EMPIRICAL", "AUTHOR_INTERPRETATION", "SECONDARY_EVIDENCE", "EXPERT_OPINION", "UNKNOWN", null],
            "description": "Scientific strength of the claim itself in broader synthesis."
          },
          "evidence_level": {
            "type": "string",
            "enum": ["E1_EXPLICIT", "E2_DERIVED", "E3_REFERENCED", "E4_NR"],
            "description": "Backward-compatible alias for support_type."
          },
          "verbatim_quote": { "type": "string" },
          "source_type": {
            "type": "string",
            "enum": ["Text", "Table", "Figure", "Supplement", "NR"]
          },
          "location": {
            "type": "object",
            "properties": {
              "page": { "type": ["integer", "null"] },
              "section": { "type": "string" },
              "table_or_figure_id": { "type": "string" }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "PARTIALLY_SUPPORTED",
              "UNSUPPORTED",
              "CONTRADICTORY",
              "AMBIGUOUS",
              "OCR_UNCERTAIN"
            ]
          },
          "claim_status": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "PARTIALLY_SUPPORTED",
              "UNSUPPORTED",
              "CONTRADICTORY",
              "AMBIGUOUS",
              "OCR_UNCERTAIN"
            ]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "auditor_verdict": {
      "type": "object",
      "required": ["verdict", "checklist_passed", "auditor_notes"],
      "properties": {
        "verdict": { "type": "string", "enum": ["PASS", "PASS_WITH_DOWNGRADES", "REJECT"] },
        "checklist_passed": { "type": "boolean" },
        "auditor_notes": { "type": "string" }
      }
    },
    "interpretation": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "content": { "type": "string" }
      }
    }
  }
}
